#!/usr/bin/env bash

set -euo pipefail

status=${1:-}
agent_type=${2:-}
owner=${3:-}
focus_update=0
[[ -n $agent_type ]] || focus_update=1
registry=${TMUX_AGENT_RUNS:-$HOME/.local/bin/runs}
socket=
title=
payload='{}'
if [[ ! -t 0 ]]; then
  payload=$(cat)
  [[ -n $payload ]] || payload='{}'
fi

session_id=
transcript_path=
cwd=
if command -v jq >/dev/null 2>&1; then
  jq -e 'type == "object"' <<< "$payload" >/dev/null 2>&1 || exit 0
  { read -r session_id; read -r transcript_path; read -r cwd; } < <(
    jq -r '.session_id, .transcript_path, .cwd | if type == "string" then . else "" end' <<< "$payload"
  ) || true
fi

if [[ -z $agent_type ]]; then
  case $transcript_path in
    "$HOME/.codex/"*) agent_type=codex ;;
    *)
      if [[ $session_id == ses_* ]]; then
        agent_type=opencode
      fi
      ;;
  esac
fi

case $status in
  ready|working|waiting|done|error|clear) ;;
  *)
    printf 'Usage: %s {ready|working|waiting|done|error|clear} [claude|codex|opencode] [owner]\n' "$0" >&2
    exit 2
    ;;
esac
case $agent_type in
  ''|claude|codex|opencode) ;;
  *) exit 2 ;;
esac

report_session() {
  [[ -x $registry && -n $session_id ]] || return 0
  command -v jq >/dev/null 2>&1 || return 0
  local report
  report=$(jq --arg session "$session_id" '.session_id = $session' <<< "$payload")
  "$registry" session "$status" --agent "${agent_type:-claude}" \
    --pane "${TMUX_PANE:-}" --socket "$socket" --title "$title" \
    <<< "$report" >/dev/null 2>&1 || true
}

# Codex's shared daemon inherits another pane's environment; ambiguous matches must stay unbound.
if [[ $agent_type == codex && ( -n ${TMUX:-} || -n ${TMUX_PANE:-} ) ]]; then
  TMUX_PANE=$(
    tmux list-panes -a -F $'#{pane_id}\t#{pane_current_command}\t#{pane_current_path}\t#{@agent_session_id}' 2>/dev/null |
      awk -F '\t' -v sid="$session_id" -v cwd="$cwd" -v status="$status" '
        $2 != "codex" { next }
        sid != "" && $4 == sid { exact = $1; matches++ }
        cwd != "" && $3 == cwd && $4 == "" { fresh = $1; unclaimed++ }
        END {
          if (matches == 1) print exact
          else if (matches == 0 && unclaimed == 1 && status != "clear") print fresh
        }
      '
  ) || true
fi

if [[ -z ${TMUX_PANE:-} ]] || ! tmux display-message -p -t "$TMUX_PANE" '' >/dev/null 2>&1; then
  TMUX_PANE=
  report_session
  exit 0
fi

socket=$(tmux display-message -p -t "$TMUX_PANE" '#{socket_path}')
title=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_title}')

current_session=$(tmux show-options -pqv -t "$TMUX_PANE" @agent_session_id)
current_owner=$(tmux show-options -pqv -t "$TMUX_PANE" @agent_owner)
current_type=$(tmux show-options -pqv -t "$TMUX_PANE" @agent_type)
if [[ $status == clear ]]; then
  if [[ -n $owner && $owner != "$current_owner" ]]; then
    if [[ -n $session_id && $session_id != "$current_session" ]]; then
      report_session
    fi
    exit 0
  fi
  if [[ -n $agent_type && -n $current_type && $agent_type != "$current_type" ]]; then
    report_session
    exit 0
  fi
  if [[ -n $session_id && $session_id != "$current_session" ]]; then
    report_session
    exit 0
  fi
  [[ -n $session_id || -n $owner || -z $current_session ]] || exit 0

  session_id=${session_id:-$current_session}
  if [[ -z $agent_type ]]; then
    agent_type=$current_type
  fi
  report_session

  for field in status status_since session_id usage type owner; do
    tmux set-option -pqu -t "$TMUX_PANE" "@agent_$field"
  done
  tmux refresh-client -S 2>/dev/null || true
  exit 0
fi

if [[ -z $agent_type ]]; then
  agent_type=$current_type
  agent_type=${agent_type:-claude}
fi

if [[ -z $session_id && $focus_update == 1 ]]; then
  session_id=$current_session
fi

if [[ $session_id =~ ^[[:xdigit:]]{8}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{4}-[[:xdigit:]]{12}$ || $session_id =~ ^ses_[[:alnum:]]+$ ]]; then
  tmux set-option -pq -t "$TMUX_PANE" @agent_session_id "$session_id"
fi
tmux set-option -pq -t "$TMUX_PANE" @agent_type "$agent_type"
if [[ -n $owner ]]; then
  tmux set-option -pq -t "$TMUX_PANE" @agent_owner "$owner"
fi

notify() {
  local agent=$1 message=$2 where window client_tty flags client_pane first_tty=

  window=$(tmux display-message -p -t "$TMUX_PANE" '#{window_name}')
  # Claude's process, and so its automatic window name, is its version number
  [[ $window =~ ^[0-9.]+$ ]] && window=claude
  where="$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}') › $window"

  while IFS=$'\t' read -r client_tty flags client_pane; do
    [[ -n $first_tty ]] || first_tty=$client_tty
    # Skip when the pane is already in front of you
    if [[ $client_pane == "$TMUX_PANE" && ,$flags, == *,focused,* ]]; then
      return
    fi
  done < <(tmux list-clients -F $'#{client_tty}\t#{client_flags}\t#{pane_id}' 2>/dev/null)

  [[ -w $first_tty ]] || return 0

  # OSC 777 separates fields with semicolons, so keep them out of the text
  printf '\e]777;notify;%s;%s\e\\' "${agent//;/,}" "${where//;/,} ${message//;/,}" > "$first_tty"
}

previous=$(tmux show-options -pqv -t "$TMUX_PANE" @agent_status)

tmux set-option -pq -t "$TMUX_PANE" @agent_status "$status"
[[ $status == "$previous" ]] || tmux set-option -pq -t "$TMUX_PANE" @agent_status_since "$(date +%s)"
report_session

# Claude's statusLine stores its usage, since only it knows the session cost
if [[ $agent_type == codex && -n $transcript_path ]]; then
  tmux set-option -pq -t "$TMUX_PANE" @agent_usage \
    "$("$(dirname "${BASH_SOURCE[0]}")/tmux-agent-usage" "$transcript_path")"
fi

tmux refresh-client -S 2>/dev/null || true

# Codex posts its own notifications, so only notify for the other agents.
# Claude reports an idle prompt as waiting after it finishes; that is not news.
if [[ $agent_type != codex && $status != "$previous" ]]; then
  agent='Claude Code'
  [[ $agent_type == opencode ]] && agent=opencode

  case $status in
    waiting) [[ $previous == done ]] || notify "$agent" 'is waiting for you' ;;
    done) notify "$agent" 'finished' ;;
    error) notify "$agent" 'stopped with an error' ;;
  esac
fi
