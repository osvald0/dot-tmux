#!/usr/bin/env bash

set -euo pipefail

state_file=${1:-}

if [[ ! -f $state_file ]]; then
  exit 0
fi

pane_map=$(mktemp "${TMPDIR:-/tmp}/tmux-agent-panes.XXXXXX")
updated_state=$(mktemp "${TMPDIR:-/tmp}/tmux-resurrect-state.XXXXXX")
trap 'rm -f "$pane_map" "$updated_state"' EXIT

delimiter=$'\t'
tmux list-panes -a -F "#{session_name}${delimiter}#{window_index}${delimiter}#{pane_index}${delimiter}#{@agent_session_id}" > "$pane_map"

awk -F '\t' -v OFS='\t' '
  NR == FNR {
    if ((length($4) == 36 && $4 ~ /^[[:xdigit:]-]+$/) || $4 ~ /^ses_[[:alnum:]]+$/) {
      session_ids[$1 FS $2 FS $3] = $4
    }
    next
  }

  $1 == "pane" {
    pane = $2 FS $3 FS $6
    id = session_ids[pane]
    split(substr($11, 2), words, " ")
    tool = words[1]
    sub(/.*\//, "", tool)

    if (tool == "claude") {
      $11 = id != "" ? ":claude --resume " id : ":claude --continue"
    } else if (tool == "codex") {
      $11 = id != "" ? ":codex resume " id : ":codex resume --last"
    } else if (tool == "opencode") {
      $11 = id != "" ? ":opencode --session " id : ":opencode --continue"
    }
  }

  { print }
' "$pane_map" "$state_file" > "$updated_state"

mv "$updated_state" "$state_file"
